# Flutter, newer than the one in the pinned nixpkgs. Rebuilds nixpkgs'
# flutter derivation from a vendored data.json instead of the version in
# nixpkgs' versions/ dir. data.json is generated by nixpkgs' own updater,
# run inside a nixpkgs checkout at the same revision as flake.lock:
#   pkgs/development/compilers/flutter/update/update.py --version <version>
# It pins the SDK source hash, engine revision, Dart version/hashes, the
# flutter_tools pubspec lock, and the engine artifact hashes. To bump,
# re-run that script and replace data.json.
#
# The patches come from the pinned nixpkgs, so mkFlutter needs the matching
# versions/<line>/ dir (e.g. 3_47) to exist there for the same minor line.
{ flutterPackages, lib, path }:

let
  data = lib.importJSON ./data.json;

  flutterDir = path + "/pkgs/development/compilers/flutter";
  versionDir = flutterDir
    + "/versions/${lib.replaceStrings [ "." ] [ "_" ] (lib.versions.majorMinor data.version)}";
  getPatches = dir: map (f: dir + "/${f}") (builtins.attrNames (builtins.readDir dir));
in
flutterPackages.wrapFlutter (
  flutterPackages.mkFlutter (data // {
    patches = getPatches (flutterDir + "/patches") ++ getPatches (versionDir + "/patches");
  })
)
